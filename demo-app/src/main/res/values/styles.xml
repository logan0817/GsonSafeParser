<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 使用平台自带亮色主题，避免为了 demo 页面额外引入 AppCompat 或 Material 依赖。 -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F7F9F9</item>
        <item name="android:colorAccent">#006A6A</item>
    </style>

    <!-- 页面区块标题，统一字号和间距，方便快速扫读每个测试区域。 -->
    <style name="DemoSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">#173333</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 页面输出块，使用接近 Android Studio Logcat 的深色背景，长 JSON、事件和异常更容易按行查看。 -->
    <style name="DemoOutputBlock">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">#1E1E1E</item>
        <item name="android:gravity">start|top</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxHeight">@dimen/demo_output_max_height</item>
        <item name="android:padding">8dp</item>
        <item name="android:paddingEnd">36dp</item>
        <item name="android:textColor">#D7E7E7</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textIsSelectable">false</item>
    </style>

    <!-- 输出区右上角提示按钮，给用户一个明显的“这里可点开全文”的信号。 -->
    <style name="DemoOutputHintButton" parent="@android:style/Widget.Material.ImageButton">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">3dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">#8FA3A3</item>
    </style>

    <!-- Spinner 统一加边框和下拉箭头，避免看起来像不可点击的普通白色输入框。 -->
    <style name="DemoSpinner" parent="@android:style/Widget.Material.Spinner">
        <item name="android:background">@drawable/bg_demo_spinner</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:popupBackground">#FFFFFF</item>
    </style>

    <!-- 当前选择说明块，用在 Spinner 下方解释“选这个会测什么”。 -->
    <style name="DemoInfoBlock">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">#243333</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textIsSelectable">false</item>
    </style>

    <!-- 主要操作按钮，给“运行、验证”这类动作使用，避免系统默认 Button 在不同设备上样式跳变。 -->
    <style name="DemoPrimaryButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_demo_button_primary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 次要操作按钮，给“恢复、复制、填入示例”这类辅助动作使用。 -->
    <style name="DemoSecondaryButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_demo_button_secondary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#124242</item>
        <item name="android:textSize">15sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
