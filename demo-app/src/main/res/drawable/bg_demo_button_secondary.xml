<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 次按钮按下时只改变底色，避免和主按钮混淆。 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#D8EAEA" />
            <stroke
                android:width="1dp"
                android:color="#006A6A" />
        </shape>
    </item>

    <!-- 禁用状态保留边框，文字颜色由 Button style 控制。 -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#F1F5F5" />
            <stroke
                android:width="1dp"
                android:color="#C9D7D7" />
        </shape>
    </item>

    <!-- 默认次按钮用于复制、恢复、填入示例这类辅助操作。 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#84A7A7" />
        </shape>
    </item>
</selector>
