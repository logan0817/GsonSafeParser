    <string name="demo_entry_core_title">Core fromJson</string>
    <string name="demo_entry_core_description">直接调用 GsonSafeParser.fromJson，适合模拟项目里普通 Gson 解析的接入方式。</string>
    <string name="demo_entry_retrofit_title">Retrofit Converter</string>
    <string name="demo_entry_retrofit_description">通过 GsonSafeConverterFactory 模拟 Retrofit 响应体转换，适合验证接口层接入后的真实表现。</string>

    <string name="demo_target_api_response_title">ApiResponse&lt;User&gt;</string>
    <string name="demo_target_api_response_description">最常见的接口外壳：code + 非空 data 对象，适合验证后端把 data 返回成 []、{}、null 的情况。</string>
    <string name="demo_target_nullable_api_response_title">NullableApiResponse&lt;User&gt;</string>
    <string name="demo_target_nullable_api_response_description">data 允许为 null 的接口外壳，适合验证 NullOnly 或低误伤策略是否更贴合你的业务。</string>
    <string name="demo_target_list_user_title">List&lt;User&gt;</string>
    <string name="demo_target_list_user_description">接口根节点就是用户列表，适合验证列表里夹杂坏数据时，是否能跳过单个元素继续解析。</string>
    <string name="demo_target_collection_title">CollectionResponse</string>
    <string name="demo_target_collection_description">同时包含 List、Set、Map 和数字列表，适合验证集合字段整体错形、单个元素错形和局部跳过。</string>
    <string name="demo_target_nullable_collection_title">NullableCollectionMapResponse</string>
    <string name="demo_target_nullable_collection_description">集合和 Map 都允许为 null，适合判断“返回 null”是否比“返回空集合”更符合业务语义。</string>
    <string name="demo_target_primitive_title">PrimitiveResponse</string>
    <string name="demo_target_primitive_description">包含 Int、Long、BigDecimal、Boolean 和 String，适合验证数字、布尔、字符串这些基础字段错形时的处理。</string>
    <string name="demo_target_map_title">MapResponse</string>
    <string name="demo_target_map_description">包含对象字段和强类型 Map，适合验证 Map 的 key、value 解析，以及局部坏数据跳过。</string>
    <string name="demo_target_map_edge_title">MapEdgeResponse</string>
    <string name="demo_target_map_edge_description">包含 Int key Map 和嵌套 Map，适合验证 key 不合法、mapItemKey 事件归因和数组形式 entry。</string>
    <string name="demo_target_any_title">AnyResponse</string>
    <string name="demo_target_any_description">包含 Any 和 Map&lt;String, Any&gt;，适合观察动态字段和 Object 数字策略是否符合项目预期。</string>
    <string name="demo_target_enum_title">EnumContainerResponse</string>
    <string name="demo_target_enum_description">同时包含 EnumSet 和 EnumMap，适合验证枚举容器在真实 App 环境下能否正常构造。</string>
    <string name="demo_target_org_json_title">OrgJsonResponse</string>
    <string name="demo_target_org_json_description">包含 JSONObject 和 JSONArray，适合验证项目里仍在使用 org.json 类型时的兼容情况。</string>

    <string name="demo_policy_default_title">默认兜底</string>
    <string name="demo_policy_default_description">使用 SafeParser 默认配置，适合先判断当前接口能不能直接接入。</string>
    <string name="demo_policy_low_interference_title">低误伤模式</string>
    <string name="demo_policy_low_interference_description">字段错形时尽量返回 null，基础类型交回 Gson，适合想先小流量观察的接入方式。</string>
    <string name="demo_policy_debug_raw_json_title">联调日志模式</string>
    <string name="demo_policy_debug_raw_json_description">开启 rawJson 捕获，适合联调时把后端原始返回和字段错配事件一起看。</string>
    <string name="demo_policy_primitive_delegate_title">基础类型按 Gson 处理</string>
    <string name="demo_policy_primitive_delegate_description">基础类型完全交给 Gson 原生 Adapter，适合确认哪些基础字段异常需要暴露出来。</string>
    <string name="demo_policy_object_number_title">Object 数字按 Long/Double</string>
    <string name="demo_policy_object_number_description">Any/Object 里的数字按 Gson LONG_OR_DOUBLE 处理，适合验证动态字段里的数字类型。</string>
    <string name="demo_policy_raw_json_truncate_title">rawJson 截断测试</string>
    <string name="demo_policy_raw_json_truncate_description">开启 rawJson 捕获，并把上限降到 10 字节，适合验证日志截断和 rawJsonTruncated 标记。</string>
</resources>
